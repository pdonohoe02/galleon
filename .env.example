# Local development configuration. Copy to .env and adjust.
#
# These values are for running the stack on your machine. The deployed floo app
# does NOT read this file — its values are set with `floo env set` and are
# listed under "Deployed equivalents" at the bottom for reference.
#
# platform-web serves three surfaces from one process, chosen by Host header
# (see apps/platform-web/src/lib/surface.ts):
#   app.galleon.localhost        -> consumer wallet
#   publishers.galleon.localhost -> publisher console
#   anything else                -> marketing landing

# Shared platform configuration
DATABASE_URL=postgresql://galleon:galleon@127.0.0.1:5432/galleon
GALLEON_ISSUER=http://galleon.localhost:3200
GALLEON_CONSUMER_URL=http://app.galleon.localhost:3200
GALLEON_PUBLISHER_URL=http://publishers.galleon.localhost:3200
GALLEON_PLATFORM_API_URL=http://127.0.0.1:3200
# Agents reach the wallet MCP at the app host's /mcp path, which platform-web
# serves in-process (apps/platform-web/src/app/mcp). No separate MCP service.
GALLEON_MCP_URL=http://app.galleon.localhost:3200/mcp
GALLEON_PUBLISHER_DEMO_URL=http://127.0.0.1:3001

# Host routing for the shared platform-web deployment
GALLEON_CONSUMER_HOST=app.galleon.localhost
GALLEON_PUBLISHER_HOST=publishers.galleon.localhost

# Shared demo-wallet MCP token. Optional: per-user tokens generated from the
# wallet onboarding screen bind an agent to that user's own wallet and need no
# config here. This shared token maps to the seeded demo wallet for a quick run
# without signing up. Never enable this in production.
GALLEON_DEMO_AUTH=false
GALLEON_DEMO_BEARER_TOKEN=replace-with-a-local-only-token

# Publisher/platform credentials and signing material. Replace every value locally.
GALLEON_PUBLISHER_API_KEY=replace-with-a-local-only-publisher-key
GALLEON_PUBLISHER_SESSION_SECRET=replace-with-a-local-only-session-secret
GALLEON_PAIRWISE_SECRET=replace-with-a-local-only-pairwise-secret
GALLEON_SIGNING_KEY_PATH=/tmp/galleon-demo-signing-private.jwk.json
WATCHPACK_POLLING=true

# ---------------------------------------------------------------------------
# Deployed equivalents (floo, dev env) — reference only, do not set them here.
#
# Where localhost runs one platform-web process on three hosts, floo runs the
# same image as three services (web / app / console), each on its own
# hostname. The two *_HOST vars are set app-wide and still resolve correctly,
# because each instance only ever receives its own hostname.
#
#   GALLEON_ISSUER=https://galleon-dev-web.on.getfloo.com
#   GALLEON_CONSUMER_URL=https://galleon-dev-app.on.getfloo.com
#   GALLEON_PUBLISHER_URL=https://galleon-dev-console.on.getfloo.com
#   GALLEON_PLATFORM_API_URL=https://galleon-dev-web.on.getfloo.com
#   GALLEON_MCP_URL=https://galleon-dev-app.on.getfloo.com/mcp
#   GALLEON_PUBLISHER_DEMO_URL=https://galleon-dev-publisher.on.getfloo.com
#   GALLEON_CONSUMER_HOST=galleon-dev-app.on.getfloo.com
#   GALLEON_PUBLISHER_HOST=galleon-dev-console.on.getfloo.com
#
# Secrets (GALLEON_DEMO_*, GALLEON_PUBLISHER_API_KEY,
# GALLEON_PUBLISHER_SESSION_SECRET, GALLEON_PAIRWISE_SECRET) are set write-only:
#   floo env set NAME --stdin --secret --app galleon
#
# DATABASE_URL is injected automatically by the managed Postgres service
# declared under [managed.default]; do not set it by hand.
#
# Inspect the live values with:  floo env list --app galleon
# Confirm the hostnames with:    floo edge routes list --app galleon
